  "narrative": {
    "northStar": "The Counter Display",
    "overview": "A bright service-counter screen: one big total, one green next-action, a three-step strip. Everything else is quiet.",
    "keyCharacteristics": [
      "Cool near-white ground, navy shell and total",
      "Green only for the next action",
      "Tabular money numerals, generous Thai line-height",
      "Total panel numerals tick to the new amount"
    ],
    "rules": [
      {
        "name": "The One Go Rule",
        "body": "Green appears on exactly one primary action per screen or dialog.",
        "section": "colors"
      },
      {
        "name": "The Navy Is Numbers Rule",
        "body": "Mint numerals live only on navy.",
        "section": "colors"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "Every amount uses tabular numerals and two decimals.",
        "section": "typography"
      },
      {
        "name": "The Flat-Until-Enabled Rule",
        "body": "A disabled action loses its shadow and drops to 45% opacity.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the scan field focused and the total visible at every viewport.",
      "Do say state in words, with an icon or label beside any colour.",
      "Do keep Thai line-height ≥ 1.5.",
      "Do keep icons drawn, 2px stroke, one set."
    ],
    "donts": [
      "Don't add a second green action to a screen.",
      "Don't reintroduce cream paper and red accents.",
      "Don't touch the receipt output when restyling.",
